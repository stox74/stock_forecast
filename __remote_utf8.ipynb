    "print(f\"PSR ?됯퇏: {endog_ratio_df['PSR'].mean():.4f}\")\n",
    "print(f\"PSR 踰붿쐞: {endog_ratio_df['PSR'].min():.4f} ~ {endog_ratio_df['PSR'].max():.4f}\")\n",
    "\n",
    "# 10. ?곗씠???덉쭏 理쒖쥌 泥댄겕\n",
