    "\n",
    "        except Exception as e:\n",
    "            print(f\"?몃뜳???앹꽦 以??ㅻ쪟: {e}\")\n",
    "            # ?몃뜳???놁씠 怨꾩냽 吏꾪뻾\n",
    "\n",
    "\n",
    "# -----------------------------\n",
